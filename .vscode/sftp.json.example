{
    "name": "Ubuntu-VM",
    "host": "127.0.0.1",
    "port": 2222,
    "protocol": "sftp",
    "username": "<YOUR_USERNAME>",
    "password": "<YOUR_PASSWORD>",
    "remotePath": "/home/<YOUR_USERNAME>/Linux-Final",
    "uploadOnSave": true,
    "useTempFile": false,
    "openSsh": false,
    "ignore": [
        "\\.vscode",
        "\\.git",
        ".DS_Store",
        "*.log",
        "build",
        "*.o"
    ]
}
